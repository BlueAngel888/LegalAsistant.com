# ── Clerk (https://dashboard.clerk.com → API Keys) ──────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ── Supabase (Project settings → API) ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_STORAGE_BUCKET=documents

# ── Anthropic (https://platform.claude.com → API Keys) ──────────────────────
ANTHROPIC_API_KEY=sk-ant-xxx
# Optional overrides
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high

# ── App ─────────────────────────────────────────────────────────────────────
# Max upload size in MB. Vercel caps request bodies at 4.5 MB for serverless
# functions, so keep this at 4 on Vercel until direct-to-storage upload lands.
MAX_UPLOAD_MB=4
